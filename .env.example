# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# Three ways to run this project, all covered below:
#   1. Real paid API (OpenAI or Anthropic) -- costs a few cents per run, best quality.
#   2. Groq free tier -- $0, no credit card, runs in the cloud. Best zero-setup free option.
#   3. Ollama -- $0, runs entirely on your own machine, no signup, no internet needed
#      after the model is downloaded once. Best if you want it fully offline.
#
# Uncomment ONE block below and leave the rest commented out.

LLM_PROVIDER=openai

# ---- Option 1: real OpenAI ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Option 1b: real Anthropic (set LLM_PROVIDER=anthropic above instead) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- Option 2: Groq free tier (cloud, $0, no credit card) ----
# 1. Sign up at https://console.groq.com (email or Google/GitHub login, no card).
# 2. Create an API key under "API Keys" in the sidebar.
# 3. Check https://console.groq.com/docs/models for the current list of models
#    and pick one that supports tool use -- openai/gpt-oss-20b is a solid default
#    as of this writing (fast, free-tier eligible, built for function calling).
# OPENAI_API_KEY=<your real Groq key>
# OPENAI_MODEL=openai/gpt-oss-20b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---- Option 3: Ollama (fully local, $0, no signup, no internet needed) ----
# 1. Install Ollama: https://ollama.com/download
# 2. Pull a tool-calling-capable model, e.g.:  ollama pull qwen2.5:7b
#    (needs a reasonably capable machine -- 16GB+ RAM recommended for a 7B model.
#    If your machine is limited, try a smaller model, e.g. qwen2.5:3b, and expect
#    somewhat weaker tool-selection accuracy.)
# 3. Make sure the Ollama app/service is running (it starts a local server on
#    port 11434 automatically after install).
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1

# Where the local vector store persists on disk. Safe to leave as-is.
CHROMA_DB_DIR=./chroma_db

# Directory containing the runbook markdown files. Defaults to sample_docs/
# relative to the project root. Only change if you've moved or replaced them.
SECOPS_DOCS_DIR=./sample_docs
